<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- XML-доки не пишем, но CS1591 не должен ломать сборку -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1873;CA1711;CA1716;CA2007;CA1031;CA1062;CA1515;CA1002;CA2227;CA1056;CA1054;CA1819;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1863</NoWarn>
  </PropertyGroup>
</Project>
